# Copy to .env, edit, then:  set -a; source .env; set +a   (before `airflow standalone`)

# Folder synced by Google Drive (contains papers/ and output/)
RESEARCH_LIBRARY_DIR="$HOME/Google Drive/ResearchLibrary"

# Local LLM, OpenAI-compatible endpoint
#   Ollama:    http://localhost:11434/v1   (model e.g. llama3.2, qwen2.5:7b)
#   LM Studio: http://localhost:1234/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2

# Discord: Server Settings > Integrations > Webhooks > New Webhook > Copy URL
DISCORD_WEBHOOK_URL=

# Optional overrides (defaults keep the DB OUTSIDE the synced folder)
# DB_PATH=./data/papers.db
# MARKDOWN_DIR=./data/markdown

# Airflow: keep everything inside this project
AIRFLOW_HOME=./airflow_home
AIRFLOW__CORE__DAGS_FOLDER=./dags
AIRFLOW__CORE__LOAD_EXAMPLES=False
